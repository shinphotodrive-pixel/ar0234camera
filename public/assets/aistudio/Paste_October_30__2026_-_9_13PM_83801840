            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 font-bold text-xs flex items-center justify-center">L2</span>
                <div>
                  <h3 class="text-sm font-bold text-slate-900">MIPI CSI-2 & I2C 제어 버스</h3>
                  <p class="text-xs text-slate-500">4-Lane D-PHY (3.6Gbps), 16-bit 레지스터 I2C</p>
                </div>
              </div>
              <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
            </div>
          </div>

          <!-- Layer 1: CMOS Physical Sensor -->
          <div onclick="selectStackLayer(1)" id="layer-card-1" class="layer-card cursor-pointer bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-blue-600 transition relative overflow-hidden">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-7 h-7 rounded-lg bg-rose-100 text-rose-700 font-bold text-xs flex items-center justify-center">L1</span>
                <div>
                  <h3 class="text-sm font-bold text-slate-900">AR0234CS 글로벌 셔터 센서 코어</h3>
                  <p class="text-xs text-slate-500">1/2.6" Pixel Array, HW Trigger & Flash Strobe Pin</p>
                </div>
              </div>
              <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
            </div>
          </div>
        </div>

        <!-- Layer Detailed Breakdown (Right 7 cols) -->
        <div class="lg:col-span-7">
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-full flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
