          </div>

          <!-- Layer 3: ISP Engine -->
          <div onclick="selectStackLayer(3)" id="layer-card-3" class="layer-card cursor-pointer bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-blue-600 transition relative overflow-hidden">
            <div class="flex items-center justify-between">
              <div class="flex items-center space-x-3">
                <span class="w-7 h-7 rounded-lg bg-emerald-100 text-emerald-700 font-bold text-xs flex items-center justify-center">L3</span>
                <div>
                  <h3 class="text-sm font-bold text-slate-900">ISP 파이프라인 & UVC 엔지니어링</h3>
