          <!-- Layer 5: App & Host OS -->
          <div onclick="selectStackLayer(5)" id="layer-card-5" class="layer-card cursor-pointer bg-white p-4 rounded-xl border border-blue-500 shadow-sm hover:border-blue-600 transition relative overflow-hidden">
