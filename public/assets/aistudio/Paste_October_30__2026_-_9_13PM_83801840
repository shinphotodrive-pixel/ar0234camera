              <button onclick="triggerPacketAnimation()" class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-medium px-4 py-2 rounded-lg flex items-center space-x-1.5 transition">
                <i data-lucide="play-circle" class="w-4 h-4 text-emerald-400"></i>
