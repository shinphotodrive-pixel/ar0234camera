      const data = stackData[layerNum];
      document.getElementById('stack-detail-badge').innerText = `L${layerNum} Layer Details`;
      document.getElementById('stack-detail-bus').innerText = data.bus;
      document.getElementById('stack-detail-title').innerText = data.title;
      document.getElementById('stack-detail-desc').innerText = data.desc;
      document.getElementById('stack-detail-note').innerText = data.note;

      const propsDiv = document.getElementById('stack-detail-props');
      propsDiv.innerHTML = `
        <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
          <span class="text-slate-500 block mb-0.5">${data.p1[0]}</span>
          <span class="font-bold text-slate-800">${data.p1[1]}</span>
        </div>
        <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
          <span class="text-slate-500 block mb-0.5">${data.p2[0]}</span>
          <span class="font-bold text-slate-800">${data.p2[1]}</span>
        </div>
        <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
          <span class="text-slate-500 block mb-0.5">${data.p3[0]}</span>
          <span class="font-bold text-slate-800">${data.p3[1]}</span>
        </div>
        <div class="bg-slate-50 p-3 rounded-lg border border-slate-200">
          <span class="text-slate-500 block mb-0.5">${data.p4[0]}</span>
          <span class="font-bold text-slate-800">${data.p4[1]}</span>
        </div>
      `;
    }

    function triggerPacketAnimation() {
      alert("1080p 60fps 비디오 패킷 파이프라인 시뮬레이션:\n\n1. AR0234CS 픽셀 수광 (16.6ms 노출)\n2. MIPI CSI-2 4-Lane 3.6Gbps 전송\n3. ISP MJPEG 엔코딩 (압축비 20:1)\n4. USB 2.0 EP1 Isochronous 24.57MB/s 전송\n5. V4L2 mmap 버퍼 큐 수신 완료!");
    }

    // ------------------------------------------------------------------
    // TAB 2: I2C & Double Buffering Logic
    // ------------------------------------------------------------------
    let pendingExposureHex = "0x04E2";
    let pendingExposureMs = "12.5";

    function updateI2CPendingValue(val) {
      const ms = parseFloat(val).toFixed(1);
      const regVal = Math.round(val * 100);
      const hexStr = "0x" + regVal.toString(16).padStart(4, '0').toUpperCase();
      
      document.getElementById('slider-exposure-val').innerText = `${ms} ms (${hexStr})`;
      pendingExposureHex = hexStr;
      pendingExposureMs = ms;
    }

    function writeI2CRegister() {
      document.getElementById('reg-pending-box').innerText = `${pendingExposureHex} (${pendingExposureMs}ms)`;
      document.getElementById('i2c-status-log').innerText = `[I2C Write Success] Pending Register updated to ${pendingExposureHex}. Waiting for VSync Frame Start...`;
      document.getElementById('i2c-status-log').className = "text-[11px] text-amber-600 text-center mt-2 font-mono font-bold";
    }

    function triggerFrameStartVSync() {
      const pendingText = document.getElementById('reg-pending-box').innerText;
      document.getElementById('reg-live-box').innerText = pendingText;
      document.getElementById('i2c-status-log').innerText = `[Frame Start Blanking] Pending -> Live Register Transfer Complete! Active Exposure: ${pendingText}`;
      document.getElementById('i2c-status-log').className = "text-[11px] text-emerald-600 text-center mt-2 font-mono font-bold";
    }

    let currentContext = 'A';
    function toggleContextSwitch() {
      const label = document.getElementById('active-context-label');
      if (currentContext === 'A') {
        currentContext = 'B';
        label.innerText = "Context B (HD 720p @ 120fps)";
        label.className = "text-xs text-emerald-600 font-mono font-bold";
      } else {
        currentContext = 'A';
        label.innerText = "Context A (Full HD 1080p @ 60fps)";
        label.className = "text-xs text-blue-600 font-mono font-bold";
      }
    }

    // ------------------------------------------------------------------
    // TAB 3: UVC Topology & V4L2 Mapping Logic
    // ------------------------------------------------------------------
    const xuSpecs = {
      trigger_mode: {
        guid: "48-61-6d-70-6f-74-65-63-68-41-30-32-33-34-01",
        selector: "bUnitID = 0x03, Selector = 0x01",
        size: "size = 8 bits, offset = 0",
        v4l2_id: "V4L2_CID_USER_HAMPO_TRIG_MODE",
        name: "Hardware Trigger Mode",
        code: `/* V4L2 Mapping C Code: HW Trigger Mode */
struct uvc_xu_control_mapping map_trig = {
    .id        = V4L2_CID_USER_BASE + 0x1001,
    .name      = "HW External Trigger Mode",
    .entity    = {0x48, 0x61, 0x6d, 0x70, 0x6f, 0x74, 0x65, 0x63, 0x68, 0x41, 0x30, 0x32, 0x33, 0x34, 0x00, 0x01},
    .selector  = 1, // Control Selector 1
    .size      = 8, // 1 Byte payload
    .offset    = 0,
    .v4l2_type = V4L2_CTRL_TYPE_INTEGER,
    .data_type = UVC_CTRL_DATA_TYPE_UNSIGNED,
};
ioctl(fd, UVCIOC_CTRL_MAP, &map_trig);`
      },
      strobe_delay: {
        guid: "48-61-6d-70-6f-74-65-63-68-41-30-32-33-34-02",
        selector: "bUnitID = 0x03, Selector = 0x02",
        size: "size = 16 bits, offset = 0",
        v4l2_id: "V4L2_CID_USER_HAMPO_FLASH_DELAY",
        name: "Flash Strobe Delay",
        code: `/* V4L2 Mapping C Code: Strobe Flash Lead/Lag */
struct uvc_xu_control_mapping map_flash = {
    .id        = V4L2_CID_USER_BASE + 0x1002,
    .name      = "Strobe Flash Lead/Lag Delay (us)",
    .entity    = {0x48, 0x61, 0x6d, 0x70, 0x6f, 0x74, 0x65, 0x63, 0x68, 0x41, 0x30, 0x32, 0x33, 0x34, 0x00, 0x02},
    .selector  = 2, // Control Selector 2
    .size      = 16, // 2 Bytes payload
    .offset    = 0,
    .v4l2_type = V4L2_CTRL_TYPE_INTEGER,
    .data_type = UVC_CTRL_DATA_TYPE_UNSIGNED,
};
ioctl(fd, UVCIOC_CTRL_MAP, &map_flash);`
      },
      direct_reg: {
        guid: "48-61-6d-70-6f-74-65-63-68-41-30-32-33-34-03",
        selector: "bUnitID = 0x03, Selector = 0x03",
        size: "size = 32 bits, offset = 0",
        v4l2_id: "V4L2_CID_USER_HAMPO_REG_DIRECT",
        name: "Direct I2C Register RW",
        code: `/* V4L2 Mapping C Code: Direct I2C Register Access */
struct uvc_xu_control_mapping map_reg = {
    .id        = V4L2_CID_USER_BASE + 0x1003,
    .name      = "Sensor Register Direct Access",
    .entity    = {0x48, 0x61, 0x6d, 0x70, 0x6f, 0x74, 0x65, 0x63, 0x68, 0x41, 0x30, 0x32, 0x33, 0x34, 0x00, 0x03},
    .selector  = 3, // Control Selector 3
    .size      = 32, // 4 Bytes payload (Address + Data)
    .offset    = 0,
    .v4l2_type = V4L2_CTRL_TYPE_INTEGER,
    .data_type = UVC_CTRL_DATA_TYPE_RAW,
};
ioctl(fd, UVCIOC_CTRL_MAP, &map_reg);`
      },
      roi_crop: {
        guid: "48-61-6d-70-6f-74-65-63-68-41-30-32-33-34-04",
        selector: "bUnitID = 0x03, Selector = 0x04",
        size: "size = 64 bits, offset = 0",
        v4l2_id: "V4L2_CID_USER_HAMPO_ROI_CROP",
        name: "ROI Window Crop",
        code: `/* V4L2 Mapping C Code: ROI Window Crop */
struct uvc_xu_control_mapping map_roi = {
    .id        = V4L2_CID_USER_BASE + 0x1004,
    .name      = "Sensor ROI Hardware Window",
    .entity    = {0x48, 0x61, 0x6d, 0x70, 0x6f, 0x74, 0x65, 0x63, 0x68, 0x41, 0x30, 0x32, 0x33, 0x34, 0x00, 0x04},
    .selector  = 4,
    .size      = 64, // 8 Bytes (X, Y, W, H)
    .offset    = 0,
    .v4l2_type = V4L2_CTRL_TYPE_INTEGER,
    .data_type = UVC_CTRL_DATA_TYPE_UNSIGNED,
};
ioctl(fd, UVCIOC_CTRL_MAP, &map_roi);`
      }
    };

    function generateV4L2Code() {
      const selected = document.getElementById('select-xu-control').value;
      const data = xuSpecs[selected];

      document.getElementById('xu-val-guid').innerText = data.guid;
      document.getElementById('xu-val-selector').innerText = data.selector;
      document.getElementById('xu-val-size').innerText = data.size;
      document.getElementById('v4l2-code-block').innerText = data.code;
    }

    function selectUVCEntity(entityId) {
      document.querySelectorAll('.uvc-node').forEach(node => {
        node.classList.remove('border-blue-500', 'bg-blue-50');
        node.classList.add('border-slate-200', 'bg-slate-50');
      });

      const selectedNode = document.getElementById(`uvc-node-${entityId}`);
      if (selectedNode) {
        selectedNode.classList.remove('border-slate-200', 'bg-slate-50');
        selectedNode.classList.add('border-blue-500', 'bg-blue-50');
      }
    }

    function testUVCRequest(reqType) {
      const resBox = document.getElementById('uvc-req-result');
      resBox.classList.remove('hidden');
      
      if (reqType === 'SET_CUR') {
        resBox.innerText = `[UVC Control Request] SET_CUR sent to EP0.\nPayload: 0x01 (Trigger Pulsed Mode Enabled)\nResult: USB ACK (Status 0x00 Success)`;
      } else if (reqType === 'GET_CUR') {
        resBox.innerText = `[UVC Control Request] GET_CUR executed.\nReturned Current Value: 0x01\nPayload Length: 1 Byte`;
      } else if (reqType === 'GET_INFO') {
        resBox.innerText = `[UVC Control Request] GET_INFO executed.\nCapabilities Bitmask: 0x03 (Bit 0: GET supported, Bit 1: SET supported)`;
      }
    }

    // ------------------------------------------------------------------
    // TAB 4: Bandwidth Calculator & Chart.js Logic
    // ------------------------------------------------------------------
    let bandwidthChart = null;

    function initBandwidthChart() {
      const ctx = document.getElementById('bandwidthChart').getContext('2d');
      bandwidthChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['YUY2 비압축', 'MJPEG 압축', 'USB 2.0 가용 한계', 'USB 3.0 가용 한계'],
          datasets: [{
            label: '데이터 대역폭 (Mbps)',
            data: [1990, 48, 350, 4000],
            backgroundColor: [
              'rgba(239, 68, 68, 0.85)',  // Red for high bandwidth
              'rgba(16, 185, 129, 0.85)', // Green for MJPEG
              'rgba(245, 158, 11, 0.85)', // Amber for USB 2.0
              'rgba(37, 99, 235, 0.85)'   // Blue for USB 3.0
            ],
            borderColor: [
              '#dc2626',
              '#059669',
              '#d97706',
              '#1d4ed8'
            ],
            borderWidth: 1.5,
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return ` 대역폭: ${context.parsed.y} Mbps`;
                }
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              title: {
                display: true,
                text: 'Mbps (메가비트/초)'
              }
            }
          }
        }
      });
    }

    function recalculateBandwidth() {
      const resVal = document.getElementById('bw-res-select').value;
      const fps = parseInt(document.getElementById('bw-fps-slider').value);
      document.getElementById('bw-fps-val').innerText = `${fps} FPS`;

      let width = 1920, height = 1080;
      if (resVal === '1920x1200') { width = 1920; height = 1200; }
      else if (resVal === '1280x720') { width = 1280; height = 720; }
      else if (resVal === '640x480') { width = 640; height = 480; }

      // YUY2 Formula: W * H * 16 * FPS
      const yuy2Bps = width * height * 16 * fps;
      const yuy2Mbps = (yuy2Bps / 1000000).toFixed(1);
      const yuy2Gbps = (yuy2Bps / 1000000000).toFixed(2);

      // MJPEG estimated compression (~20:1 ratio)
      const mjpegMbps = (yuy2Mbps / 20).toFixed(1);

      document.getElementById('formula-yuy2').innerText = `${width} x ${height} x 16 x ${fps} = ${yuy2Gbps} Gbps (${yuy2Mbps} Mbps)`;
      document.getElementById('formula-mjpeg').innerText = `약 ${mjpegMbps} Mbps (압축률 ~20:1)`;

      // Update Chart
      if (bandwidthChart) {
        bandwidthChart.data.datasets[0].data = [parseFloat(yuy2Mbps), parseFloat(mjpegMbps), 350, 4000];
        bandwidthChart.update();
      }

      // Update USB Status Badge
      const statusBox = document.getElementById('usb-status-box');
      const statusTitle = document.getElementById('usb-status-title');
      const statusDesc = document.getElementById('usb-status-desc');

      if (parseFloat(mjpegMbps) <= 350) {
        statusBox.className = "p-3 rounded-xl border text-xs font-bold space-y-1 bg-emerald-50 text-emerald-900 border-emerald-200";
        statusTitle.innerText = "USB 2.0 (MJPEG) 전송 가능";
        statusDesc.innerText = `MJPEG 포맷(${mjpegMbps} Mbps)은 USB 2.0 가용 대역폭(350 Mbps) 이하이므로 프레임 드롭 없이 전송됩니다.`;
      } else {
        statusBox.className = "p-3 rounded-xl border text-xs font-bold space-y-1 bg-amber-50 text-amber-900 border-amber-200";
        statusTitle.innerText = "USB 2.0 대역폭 초과 위험";
        statusDesc.innerText = `MJPEG 포맷(${mjpegMbps} Mbps)이 USB 2.0 한계를 상회합니다. FPS를 낮추거나 USB 3.0을 사용하십시오.`;
      }
    }

    // ------------------------------------------------------------------
    // TAB 5: Canvas Rolling vs Global Shutter Simulation
    // ------------------------------------------------------------------
    let shutterMode = 'global';
    let propSpeed = 5;
    let shutterCanvas, shutterCtx;
    let animFrameId = null;
    let propAngle = 0;
    let isFlash = false;

    function setShutterMode(mode) {
      shutterMode = mode;
      const btnGlobal = document.getElementById('btn-shutter-global');
      const btnRolling = document.getElementById('btn-shutter-rolling');
      const dot = document.getElementById('shutter-canvas-dot');
      const title = document.getElementById('shutter-canvas-mode-title');
      const evalText = document.getElementById('shutter-evaluation-text');

      if (mode === 'global') {
        btnGlobal.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white transition";
        btnRolling.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 transition";
        dot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse";
        title.innerText = "글로벌 셔터 모드: 전 전체 픽셀 동시 수광 (왜곡 없음)";
        evalText.innerText = "완벽한 기하학적 형태 보존 (0% Skew)";
        evalText.className = "font-bold text-emerald-600";
      } else {
        btnRolling.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white transition";
        btnGlobal.className = "px-3 py-1.5 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 transition";
        dot.className = "w-2 h-2 rounded-full bg-rose-500 animate-pulse";
        title.innerText = "롤링 셔터 모드: 순차적 행 스캔 (대각선 왜곡 발생)";
        evalText.innerText = "젤로 현상(Skew Artifacts) 및 가로 밴드 노이즈 발생";
        evalText.className = "font-bold text-rose-600";
      }
    }

    function updateShutterSpeed(val) {
      propSpeed = parseInt(val);
    }

    function triggerFlashStrobe() {
      isFlash = true;
      setTimeout(() => { isFlash = false; }, 150);
    }

    function initShutterCanvas() {
      shutterCanvas = document.getElementById('shutterCanvas');
      if (!shutterCanvas) return;
      
      const parent = shutterCanvas.parentElement;
      shutterCanvas.width = parent.clientWidth;
      shutterCanvas.height = parent.clientHeight;
      shutterCtx = shutterCanvas.getContext('2d');

      if (animFrameId) cancelAnimationFrame(animFrameId);
      renderShutterLoop();
    }

    function renderShutterLoop() {
      if (!shutterCtx) return;
      const w = shutterCanvas.width;
      const h = shutterCanvas.height;
      const centerX = w / 2;
      const centerY = h / 2;

      // Clear Canvas
      shutterCtx.fillStyle = isFlash ? '#ffffff' : '#0f172a';
      shutterCtx.fillRect(0, 0, w, h);

      // Draw Grid Lines on Canvas
      shutterCtx.strokeStyle = isFlash ? '#cbd5e1' : '#1e293b';
      shutterCtx.lineWidth = 1;
      for (let x = 0; x < w; x += 30) {
        shutterCtx.beginPath();
        shutterCtx.moveTo(x, 0);
        shutterCtx.lineTo(x, h);
        shutterCtx.stroke();
      }

      propAngle += propSpeed * 0.04;

      if (shutterMode === 'global') {
        // Draw Crisp Propeller
        drawPropeller(shutterCtx, centerX, centerY, propAngle, false);
      } else {
        // Draw Rolling Shutter Distortion (Row-by-Row Skew)
        if (isFlash) {
          // Draw Partial Flash Horizontal Band
          shutterCtx.fillStyle = 'rgba(255, 255, 255, 0.9)';
          shutterCtx.fillRect(0, centerY - 20, w, 40);
        }
        drawPropeller(shutterCtx, centerX, centerY, propAngle, true);
      }

      animFrameId = requestAnimationFrame(renderShutterLoop);
    }

    function drawPropeller(ctx, cx, cy, angle, isRolling) {
      const numBlades = 3;
      const radius = 75;

      for (let i = 0; i < numBlades; i++) {
        const bladeAngle = angle + (i * (2 * Math.PI / numBlades));

        ctx.save();
        ctx.translate(cx, cy);

        if (isRolling) {
          // Simulate Rolling Skew by slicing horizontally
          ctx.fillStyle = '#f59e0b';
          for (let y = -radius; y <= radius; y += 4) {
            const rowSkewAngle = bladeAngle + (y * 0.012);
            const x1 = Math.cos(rowSkewAngle) * (y);
            const y1 = Math.sin(rowSkewAngle) * (y);
            ctx.beginPath();
            ctx.arc(x1, y1, 6, 0, Math.PI * 2);
            ctx.fill();
          }
        } else {
          // Clean Solid Propeller Blade
          ctx.rotate(bladeAngle);
          ctx.fillStyle = '#3b82f6';
          ctx.beginPath();
          ctx.ellipse(radius / 2, 0, radius / 2, 10, 0, 0, Math.PI * 2);
          ctx.fill();
        }

        ctx.restore();
      }

      // Center Hub
      ctx.beginPath();
      ctx.arc(cx, cy, 12, 0, Math.PI * 2);
      ctx.fillStyle = '#64748b';
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    function calculateTriggerExposure(val) {
      const periodMs = parseFloat(val);
      const periodHz = (1000 / periodMs).toFixed(1);
      document.getElementById('trig-period-val').innerText = `${periodMs.toFixed(1)} ms (${periodHz} Hz)`;

      // Formula: Max Exp < Period - (1/120) - 1.6ms
      const maxExpMs = periodMs - (1000 / 120) - 1.6;
      const safeMax = Math.max(0.1, maxExpMs).toFixed(2);
      const maxUs = Math.round(safeMax * 1000);

      document.getElementById('trig-max-exp-result').innerText = `${safeMax} ms (${maxUs.toLocaleString()} µs)`;
    }

    // ------------------------------------------------------------------
    // Window Onload Initialization
    // ------------------------------------------------------------------
    window.addEventListener('DOMContentLoaded', () => {
      selectStackLayer(5);
      generateV4L2Code();
      initBandwidthChart();
      recalculateBandwidth();
      initShutterCanvas();
    });

    window.addEventListener('resize', () => {
      if (shutterCanvas) {
        initShutterCanvas();
      }
    });
  </script>
